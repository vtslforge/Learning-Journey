<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Hotel</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-900">

    <%- include('partials/navbar.ejs') %>

    <main class="min-h-[80vh] flex items-center justify-center px-6">

        <div class="w-full max-w-md bg-white border rounded-lg p-8">

            <h1 class="text-2xl font-semibold mb-2">
                Add Hotel
            </h1>

            <p class="text-sm text-gray-500 mb-6">
                Enter the hotel details.
            </p>

            <form action="/auth" method="POST" class="space-y-5">

                <div>
                    <label for="hotelName" class="block text-sm font-medium mb-2">
                        Hotel Name
                    </label>

                    <input
                        type="text"
                        id="hotelName"
                        name="hotelName"
                        required
                        class="w-full border rounded-md px-4 py-2.5 outline-none focus:ring-2"
                    >
                </div>

                <div>
                    <label for="location" class="block text-sm font-medium mb-2">
                        Location
                    </label>

                    <input
                        type="text"
                        id="location"
                        name="location"
                        required
                        class="w-full border rounded-md px-4 py-2.5 outline-none focus:ring-2"
                    >
                </div>

                <div>
                    <label for="price" class="block text-sm font-medium mb-2">
                        Price per Night
                    </label>

                    <input
                        type="number"
                        id="price"
                        name="price"
                        required
                        class="w-full border rounded-md px-4 py-2.5 outline-none focus:ring-2"
                    >
                </div>

                <div>
                    <label for="rating" class="block text-sm font-medium mb-2">
                        Rating
                    </label>

                    <input
                        type="number"
                        id="rating"
                        name="rating"
                        min="0"
                        max="5"
                        step="0.1"
                        required
                        class="w-full border rounded-md px-4 py-2.5 outline-none focus:ring-2"
                    >
                </div>

                <button
                    type="submit"
                    class="w-full bg-black text-white rounded-md py-2.5 hover:bg-gray-800"
                >
                    Add Hotel
                </button>

            </form>

        </div>

    </main>

</body>
</html>